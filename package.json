{
  "name": "grain",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit",
    "build:web": "vp build",
    "preview": "vp preview",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "analyze:unused": "knip --no-progress --reporter compact",
    "analyze:unused:production": "knip --production --no-progress --reporter compact",
    "test": "vp test run --project node",
    "test:watch": "vp test --project node",
    "test:browser": "vp test run --project browser",
    "test:all": "vp test run",
    "bench:canonical-history": "CANONICAL_HISTORY_BENCHMARK=1 vp test run --project node src/markdown/canonical-actions.benchmark.test.ts --disableConsoleIntercept",
    "bench:yjs-m0": "node benchmarks/yjs-m0/run.mjs",
    "test:extensive-smoke": "MARKDOWN_EXTENSIVE_SMOKE_TESTS=1 vp test run --project node src/markdown/block-parser.permutations.test.ts",
    "test:extensive": "MARKDOWN_EXTENSIVE_TESTS=1 vp test run --project node src/markdown/block-parser.permutations.test.ts"
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@preact/signals-core": "^1.14.2",
    "lit": "^3.3.3",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@vitest/browser-playwright": "5.0.5",
    "knip": "6.41.0",
    "playwright": "^1.60.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "vite": "$vite"
  }
}
